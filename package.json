{
  "name": "uni-toolkit",
  "type": "module",
  "version": "0.7.0",
  "packageManager": "pnpm@10.34.5",
  "description": "uni tools,uni app 工具库",
  "author": "liujiayii <liujiayii@foxmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/liujiayii/uni-toolkit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liujiayii/uni-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/liujiayii/uni-toolkit/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.js",
      "require": "./dist/env/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js"
    },
    "./interceptors": {
      "types": "./dist/interceptors/index.d.ts",
      "import": "./dist/interceptors/index.js",
      "require": "./dist/interceptors/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts"
    },
    "./style/*": "./dist/style/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "changeset": "changeset",
    "clean": "rimraf dist",
    "build": "node scripts/build.js",
    "build2": "tsdown",
    "dev": "npm run clean && tsc --watch",
    "dev2": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "check": "run-p lint typecheck test:run",
    "check:fast": "run-p typecheck test:run",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "pnpm run docs:build && gh-pages -d docs/.vitepress/dist --add"
  },
  "dependencies": {
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-app": "3.0.0-4070620250821001",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.69.0",
    "@uni-helper/uni-use": "^0.19.17",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "2.0.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "vue": "^3.5.21",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "*.{js,ts,vue,md}": "eslint --cache --fix"
  }
}
